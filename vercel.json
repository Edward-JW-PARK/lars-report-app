{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/generate-outcome-report",
      "destination": "/api/generate-outcome-report"
    },
    {
      "source": "/api/generate-coaching-report",
      "destination": "/api/generate-coaching-report"
    },
    {
      "source": "/api/evaluations/:id*",
      "destination": "/api/evaluations"
    },
    {
      "source": "/api/evaluations",
      "destination": "/api/evaluations"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
